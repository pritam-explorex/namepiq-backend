APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://namepiq:namepiq@localhost:5432/namepiq?sslmode=disable
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=24h
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
MIGRATIONS_DIR=migrations

# MCP (cmd/mcp) — optional pre-auth JWT; or use the login tool
NAMEPIQ_API_BASE=http://localhost:8080
NAMEPIQ_TOKEN=

# Comma-separated emails promoted to admin on API boot
ADMIN_EMAILS=

# OpenSRS (horizon for test; live needs IP allowlist)
OPENSRS_USERNAME=
OPENSRS_API_KEY=
OPENSRS_ENDPOINT=https://horizon.opensrs.net:55443
# Stage/Horizon: 2 (default). Production: 50 (hard-capped).
OPENSRS_MAX_CONCURRENT=2

# Retail pricing (wholesale USD → shopper currency via Frankfurter; INR fallback)
USD_INR_RATE=84
RETAIL_MARKUP_PERCENT=0
DISPLAY_DISCOUNT_PERCENT=0

# Razorpay (use rzp_test_* keys for stage; webhook secret optional until live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (send-only; Cloudflare keeps inbound forwarding)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Namepiq <noreply@namepiq.com>

# Telegram ops alerts (Namepiqbot) — message the bot once, then get chat id via getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web (Cloudflare Pages / local)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_RAZORPAY_KEY_ID=
